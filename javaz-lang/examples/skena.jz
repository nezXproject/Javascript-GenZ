// --- 1. Variabel & Literals ---
fix nama_project = "JavaZ Lang";
p status_keren = fakta;
p budget = ghosting;

liat("Selamat datang di " + nama_project);

// --- 2. Function & Logic ---
jurus cekKhodam(nama) {
    terus? (nama === "Budi") {
        spill "Khodam lu Naga Sakti ngab!";
    } kalo enggak terus? (nama === "Siti") {
        spill "Khodam lu Kucing Oren ges.";
    } kalo enggak {
        spill "Lu mah NPC bro, gada khodam.";
    }
}

liat(cekKhodam("Budi"));
liat(cekKhodam("Asep"));
liat("---");

// --- 3. Looping & Control Flow ---
liat("Mulai gacha...");
muter (p i = 1; i <= 5; i++) {
    terus? (i === 3) {
        liat("Gacha ke-" + i + ": Ampas, skip animasinya!");
        skip;
    }
    
    terus? (i === 5) {
        liat("Gacha ke-" + i + ": Dapet SSR! Udahan ah mager.");
        mager;
    }
    
    liat("Gacha ke-" + i + ": Ampas bang.");
}
liat("---");

// --- 4. Class & OOP Lanjut ---
sirkel Tongkrongan {
    constructor(lokasi) {
        gue.lokasi = lokasi;
    }
    
    info() {
        liat("Kita nongkrong di " + gue.lokasi);
    }
}

// Inheritance (nebeng class)
sirkel AnakSenja nebeng Tongkrongan {
    pesenKopi() {
        coba_dulu {
            p stok = hoax;
            terus? (stok === hoax) {
                emosi "Kopinya abis cuy!"; // throw error
            }
        } kalo_error (masalah) {
            liat("Waduh masalah nih: " + masalah);
        } pokoknya {
            liat("Tetep santuy walau kopi abis.");
        }
    }
}

p skenaBoy = anak_baru AnakSenja("Kopi Sudut");
skenaBoy.info();
skenaBoy.pesenKopi();
